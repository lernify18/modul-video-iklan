{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modul-video-iklan",
  "compatibility_date": "2026-10-12",
  "main": "worker/index.ts",
  // Every request passes the Worker first: without a session only the sign-in page is served (worker/akses.ts).
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modul-video-iklan",
      // Before deploying: `pnpm exec wrangler d1 create modul-video-iklan` and paste its id here. Local runs use .wrangler/.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
